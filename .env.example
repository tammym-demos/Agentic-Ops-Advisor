# === Azure AI Foundry ===
AZURE_AI_AGENTS_ENDPOINT=https://your-hub.services.ai.azure.com/api/projects/your-project
# Legacy connection string (v1 SDK, deprecated — use AZURE_AI_AGENTS_ENDPOINT instead):
# AZURE_AI_PROJECT_CONNECTION_STRING=your-project-connection-string
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# === Database ===
# Local dev: leave empty or set to "sqlite" to use local SQLite
# Azure: set to your Azure SQL connection string
DB_MODE=sqlite
# DB_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=your-server.database.windows.net;Database=agentops;Authentication=ActiveDirectoryDefault;

# === Feature Flags ===
ENABLE_WORK_IQ=true
ENABLE_MCP=false

# === Observability ===
APPLICATIONINSIGHTS_CONNECTION_STRING=your-app-insights-connection-string
AZURE_TRACING_GEN_AI_CONTENT_RECORDING_ENABLED=false

# === Container Deployment ===
# ACR login server URL (from Bicep output)
# ACR_LOGIN_SERVER=crhubagentopsprod.azurecr.io
# CONTAINER_IMAGE_TAG=latest

# === Azure (for Bicep deployment) ===
AZURE_SUBSCRIPTION_ID=e0b48569-71a2-40fe-9b7a-2fb859f31288
AZURE_RESOURCE_GROUP=rg-agentic-ops-advisor
AZURE_LOCATION=eastus2
